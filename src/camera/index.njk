---
layout: base.njk
title: "seenalready: Cameras"
permalink: /camera/
activeNav: cameras
---
{% set cams = collections.cameras | sort(attribute="data.order") %}
<div class="body">
  <div class="pagelabel">Cameras</div>
  {# Each tile is a line etching of the camera, traced from its product photo by
     scripts/prep-images.mjs. The PNG is used as a CSS mask over var(--fg), so the lines
     follow the theme (black / beige) and pick up the hover color. #}
  <div class="etchgrid">
    {% for cam in cams %}
      <a class="etchtile" href="{{ cam.url }}">
        <div class="etch" role="img" aria-label="Drawing of the {{ cam.data.name }}" style="--etch: url('/img/etch/{{ cam.data.slug }}.png')"></div>
        <div class="tile-cap-main">{{ cam.data.name }}</div>
      </a>
    {% endfor %}
  </div>
  <div class="footer">
    <a class="archive-link" href="/snapped/">SNAPPED</a>
    <div class="copy">© {{ copyrightYears }} Seen Already</div>
    {# The drawings' source photos are CC-licensed — attribution lives on /credits/. #}
    <a class="credits" href="/credits/">Image credits</a>
  </div>
</div>
