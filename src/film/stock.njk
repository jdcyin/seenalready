---
layout: base.njk
pagination:
  data: collections.filmStockList
  size: 1
  alias: stock
permalink: "/film/{{ stock.format }}/{{ stock.stockSlug }}/"
eleventyComputed:
  title: "seenalready: {{ stock.filmStock }}"
  activeNav: "film"
---
{% set rolls = stock.posts | sort(attribute="data.date", reverse=true) %}
<div class="body body-featured">
  <div class="pagelabel">{{ stock.filmStock }}</div>

  {% set top = rolls[0] %}
  <div class="feature">
    <a class="feature-img vign" href="{{ top.url }}">{% photo top.data.hero, top.data.date | formatDate(top.data.endDate), "(max-width: 720px) calc(100vw - 48px), (max-width: 1250px) calc(50vw - 56px), 570px", top, true %}</a>
    <div class="feature-body">
      <a class="feature-date" href="{{ top.url }}">{{ top.data.date | formatDate(top.data.endDate) }}</a>
      <a class="feature-btn" href="{{ top.url }}">SEE</a>
    </div>
  </div>

  {% if rolls.length > 1 %}
    <div class="section">
      <div class="eyebrow">Recent</div>
      <div class="grid">
        {% for roll in rolls | arraySlice(1, 4) %}
          <a class="card" href="{{ roll.url }}">
            <div class="card-img vign">{% photo roll.data.hero, roll.data.date | formatDate(roll.data.endDate), "(max-width: 720px) calc(100vw - 48px), (max-width: 1250px) calc(33vw - 55px), 362px", roll %}</div>
            <div class="card-cap">
              <div class="card-date">{{ roll.data.date | formatDate(roll.data.endDate) }}</div>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="footer">
    <a class="archive-link" href="/snapped/">SNAPPED</a>
    <div class="copy">© {{ copyrightYears }} Seen Already</div>
  </div>
</div>
